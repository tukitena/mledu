                    <mxGeometry height="30" width="1900" x="120" y="130" as="geometry" />
                </mxCell>
                <mxCell id="scope" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=13;fontColor=#334155;" value="Quan hệ vẽ trong phạm vi trang; FK actor/scope và quan hệ chéo trang vẫn được ghi ở thuộc tính bảng. Nhấn bảng tham chiếu để đến trang đầy đủ." vertex="1">
