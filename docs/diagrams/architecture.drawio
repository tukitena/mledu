                <UserObject label="" data-model-id="fk__import_success_fingerprints__import_id" data-kind="foreign_key" data-properties="{&quot;id&quot;: &quot;fk__import_success_fingerprints__import_id&quot;, &quot;source&quot;: &quot;import_batches&quot;, &quot;target&quot;: &quot;import_success_fingerprints&quot;, &quot;source_column&quot;: &quot;id&quot;, &quot;target_column&quot;: &quot;import_id&quot;, &quot;optional&quot;: false, &quot;unique&quot;: true, &quot;s_side&quot;: &quot;B&quot;, &quot;t_side&quot;: &quot;R&quot;}" id="imports__fk__import_success_fingerprints__import_id">
