                <mxCell id="notes" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Ràng buộc nghiệp vụ / kiểm tra tại constraint + RLS / RPC&lt;/b&gt;&lt;br&gt;&lt;br&gt;FEE-11 — Một lần xét tham gia vào ngày áp dụng; không truy thu khoản một lần đã qua khi vào muộn. Định kỳ xét giao khoảng, thu đủ và không lặp trong hồ sơ.&lt;br&gt;&lt;br&gt;Đối tượng được chọn lưu theo học sinh + thời điểm lựa chọn; khoản phát sinh vẫn thuộc từng hồ sơ lớp. Cùng lớp/phiên bản/đối tượng phải được RPC kiểm tra.&lt;br&gt;&lt;br&gt;Lần tháng dùng month_start; lần kỳ dùng kỳ học phí có sẵn. starts_on/applies_on giữ ngày thực tế nếu cấu hình giữa kỳ, không lùi về đầu kỳ.&lt;br&gt;&lt;br&gt;Sửa/xóa cấu hình chỉ đổi phát sinh sau. Khoản ngoài chưa thu được sửa/hủy có lý do và phiên bản; khoản đã thu cần Admin gỡ sai trước. Không tự tạo lại khoản đã hủy." vertex="1">
                    <mxGeometry height="330" width="1900" x="120" y="1890" as="geometry" />
                </mxCell>
                <mxCell id="footer" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=13;fontColor=#334155;" value="Nguồn: docs/developer/plans.md (mã yêu cầu trong metadata bảng) + docs/developer/techstack.md, mục 1 / 4 / 5 / 6." vertex="1">
                    <mxGeometry height="30" width="1900" x="120" y="2250" as="geometry" />
                </mxCell>
