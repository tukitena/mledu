                </UserObject>
                <mxCell id="ielts-input" value="&lt;b&gt;Đầu vào theo mode&lt;/b&gt;&lt;br&gt;&lt;br&gt;L/R direct: band tay.&lt;br&gt;L/R detailed: câu đúng + band tay; không quy đổi.&lt;br&gt;&lt;br&gt;W direct: band tay.&lt;br&gt;W detailed: hai Task × bốn tiêu chí.&lt;br&gt;&lt;br&gt;S direct: band tay.&lt;br&gt;S detailed: bốn tiêu chí.&lt;br&gt;&lt;br&gt;Band/tiêu chí 0–9, bước 0,5. Thiếu dữ liệu khác band 0; kỹ năng không chọn là Không áp dụng." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=16;fillColor=#f0fdf4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="120" y="1320" width="600" height="450" as="geometry"/>
                </mxCell>
                <mxCell id="formula" value="&lt;b&gt;Công thức MLedu theo TEST-01&lt;/b&gt;&lt;br&gt;&lt;br&gt;roundBand(x) = floor(2x + 0,5) / 2&lt;br&gt;&lt;br&gt;Task1/2 = roundBand(TB bốn tiêu chí)&lt;br&gt;Writing = roundBand((Task1 + 2×Task2)/3)&lt;br&gt;Speaking = roundBand(TB bốn tiêu chí)&lt;br&gt;&lt;br&gt;Làm tròn từng Task trước Writing. Không cắt trung bình về hai số lẻ.&lt;br&gt;&lt;br&gt;Overall chỉ khi đủ L/R/W/S và bốn band; bài 1–3 kỹ năng đủ dữ liệu vẫn công bố, Overall NULL." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=16;fillColor=#f0fdf4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="120" y="1840" width="600" height="450" as="geometry"/>
                </mxCell>
                <mxCell id="criteria" value="&lt;b&gt;Mã tiêu chí cố định theo formula_version&lt;/b&gt;&lt;br&gt;&lt;br&gt;W Task 1: t1_ta / t1_cc / t1_lr / t1_gra&lt;br&gt;W Task 2: t2_tr / t2_cc / t2_lr / t2_gra&lt;br&gt;S: fc / lr / gra / pronunciation&lt;br&gt;&lt;br&gt;Trọng số tiêu chí bằng nhau trong mỗi Task/kỹ năng. Template không tùy chỉnh công thức hoặc trọng số.&lt;br&gt;&lt;br&gt;input_band nhập tay; calculated_band / Task / Overall do backend tính và không nhận ghi đè." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=16;fillColor=#f0fdf4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="1120" y="2250" width="600" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="ielts-publication" value="&lt;b&gt;Hoàn tất / hiển thị / lịch sử&lt;/b&gt;&lt;br&gt;&lt;br&gt;Đủ dữ liệu theo tất cả kỹ năng đã chọn mới hoàn tất; Vắng cả bài là ngoại lệ hợp lệ, không có band giả. Khóa công bố theo test_results, không công bố riêng kỹ năng/Task.&lt;br&gt;&lt;br&gt;Phụ huynh thấy band kỹ năng và Overall đã công bố. show_components = false phải loại câu đúng, Task và tiêu chí khỏi API. Snapshot giữ formula_version và đầu vào; đổi template/công thức mặc định không tính lại bài cũ." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=16;fillColor=#f0fdf4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="120" y="2770" width="1600" height="270" as="geometry"/>
                </mxCell>
