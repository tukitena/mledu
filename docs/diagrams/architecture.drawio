                <mxCell id="notes" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;fontSize=15;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;Ràng buộc nghiệp vụ / kiểm tra tại constraint + RLS / RPC&lt;/b&gt;&lt;br&gt;&lt;br&gt;XLS — Chỉ .xlsx, &amp;lt;10.000.000 byte và ≤5.000 dòng; trình duyệt chặn file vượt giới hạn và ô công thức. API vẫn chặn payload &amp;gt;5.000 dòng và kiểm tra lại toàn bộ; mã/phiên bản ẩn không phải cơ chế bảo mật.&lt;br&gt;&lt;br&gt;Mã không hợp lệ không được chuyển sang tra tên. File lớp chỉ liên kết hồ sơ tổng có sẵn; không tạo/khôi phục học sinh tổng hoặc tạo bài/đợt bằng file.&lt;br&gt;&lt;br&gt;Áp dụng = một request + một RPC: kiểm tra lại quyền, lưu trữ, công bố và mọi row_version; ghi dữ liệu, import_batches, fingerprint và đúng một audit trong cùng transaction. Xem trước/hủy/lỗi/không thay đổi không ghi gì.&lt;br&gt;&lt;br&gt;payload_hash do backend tính từ JSON đã chuẩn hóa; scope_key gồm chức năng + lớp + bài/đợt, không chứa tên file. UNIQUE chống hai lần áp dụng đồng thời; dấu thành công không hết hạn theo audit. Hiệu năng đọc file không đo (chấp nhận độ trễ)." vertex="1">
                    <mxGeometry height="330" width="1900" x="120" y="1800" as="geometry" />
                </mxCell>
                <mxCell id="footer" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=13;fontColor=#334155;" value="Nguồn: docs/developer/plans.md (mã yêu cầu trong metadata bảng) + docs/developer/techstack.md, mục 1 / 4 / 5 / 6." vertex="1">
                    <mxGeometry height="30" width="1900" x="120" y="2160" as="geometry" />
                </mxCell>
