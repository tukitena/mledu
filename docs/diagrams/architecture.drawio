                <UserObject id="academic-ielts__fk__ielts_criterion_results__result_id_config_id_skill" label="" data-model-id="fk__ielts_criterion_results__result_id,config_id,skill" data-kind="foreign_key" data-properties="{&quot;id&quot;: &quot;academic-ielts__fk__ielts_criterion_results__result_id_config_id_skill&quot;, &quot;source&quot;: &quot;ielts_skill_results&quot;, &quot;target&quot;: &quot;ielts_criterion_results&quot;, &quot;source_column&quot;: &quot;result_id,config_id,skill&quot;, &quot;target_column&quot;: &quot;result_id,config_id,skill&quot;, &quot;optional&quot;: false, &quot;unique&quot;: false}">
                    <mxCell parent="1" source="academic-ielts__ielts_skill_results" target="academic-ielts__ielts_criterion_results" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#64748b;strokeWidth=1.5;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
