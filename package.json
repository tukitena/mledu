{
  "name": "mledu",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 100,
    "trailingComma": "all"
  },
  "workspaces": [
    "packages/contracts",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @mledu/api",
    "dev:web": "npm run dev -w @mledu/web",
    "local:env": "node scripts/dev/supabase-env.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "db:types": "supabase gen types typescript --local --schema api > apps/api/src/generated/database.types.ts && prettier --write apps/api/src/generated/database.types.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.tools.json && npm run typecheck --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:tooling": "node --test scripts/testing/*.test.ts",
    "test:stack:prepare": "node scripts/testing/stack.ts prepare",
    "test:stack:start": "node scripts/testing/stack.ts start",
    "test:stack:stop": "node scripts/testing/stack.ts stop",
    "test:stack:reset": "node scripts/testing/stack.ts reset",
    "test:env": "node scripts/testing/stack.ts env",
    "test:db": "node scripts/testing/stack.ts db",
    "test:db:types": "node scripts/testing/stack.ts types",
    "test:db:concurrency": "node --test apps/api/tests/database/*.test.ts",
    "test:integration": "npm run test:integration -w @mledu/api",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "build": "npm run build -w @mledu/web && npm run build -w @mledu/api",
    "check:artifacts": "node scripts/dev/check-artifacts.mjs",
    "spike:db": "node scripts/auth-spike/apply-schema.ts",
    "dev:auth-spike": "node apps/api/src/local.ts",
    "test:auth-spike": "node --test --test-concurrency=1 apps/api/tests/*.test.ts",
    "test:auth:integration": "node --test --test-concurrency=1 apps/api/tests/auth.test.ts apps/api/tests/auth-atomicity.test.ts",
    "test:auth:recovery": "node --test apps/api/tests/recovery-concurrency.test.ts",
    "test:auth:expiry": "node --test apps/api/tests/slow/recovery-expiry.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vue-eslint-parser": "10.4.1"
  }
}
