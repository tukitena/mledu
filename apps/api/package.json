{
  "name": "@mledu/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist --env staging",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc -p tsconfig.spike.json",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "deploy:staging": "wrangler deploy --env staging"
  },
  "dependencies": {
    "@mledu/contracts": "*",
    "@supabase/supabase-js": "2.118.0",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.8",
    "@cloudflare/workers-types": "5.20261026.1",
    "@hono/node-server": "2.1.5",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  }
}
