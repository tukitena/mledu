# Copy to .dev.vars (ignored by Git) or run `npm run local:env` after `supabase start`.
# Values below are names only; take local values from `supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Optional in GĐ 1. Backend-only; bypasses RLS, so every use needs an explicit permission check.
SUPABASE_SECRET_KEY=
